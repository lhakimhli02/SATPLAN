;;; Medium depot problem: ship 3 stacked crates from depot0 to distributor0
;;; 2 pallets at distributor for split stacking
;;; Optimal plan length: ~13 sequential actions
(define (problem depot-medium-1) (:domain Depot)
(:objects
    depot0 distributor0 truck0 hoist0 hoist1
    pallet0 pallet1 pallet2
    crate0 crate1 crate2)
(:init
    (place depot0)
    (place distributor0)
    (depot depot0)
    (distributor distributor0)
    (truck truck0)
    (at truck0 depot0)
    (hoist hoist0)
    (at hoist0 depot0)
    (available hoist0)
    (hoist hoist1)
    (at hoist1 distributor0)
    (available hoist1)
    (pallet pallet0)
    (surface pallet0)
    (at pallet0 depot0)
    (pallet pallet1)
    (surface pallet1)
    (at pallet1 distributor0)
    (clear pallet1)
    (pallet pallet2)
    (surface pallet2)
    (at pallet2 distributor0)
    (clear pallet2)
    (crate crate0)
    (surface crate0)
    (at crate0 depot0)
    (on crate0 pallet0)
    (crate crate1)
    (surface crate1)
    (at crate1 depot0)
    (on crate1 crate0)
    (crate crate2)
    (surface crate2)
    (at crate2 depot0)
    (on crate2 crate1)
    (clear crate2)
)
(:goal (and
    (on crate0 pallet1)
    (on crate1 crate0)
    (on crate2 pallet2)
))
)
